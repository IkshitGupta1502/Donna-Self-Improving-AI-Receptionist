# Required
GEMINI_API_KEY=

# Twilio. With ACCOUNT_SID + AUTH_TOKEN + PHONE_NUMBER, `npm run live` points the number's voice
# and SMS webhooks at ngrok for you. The same number sends and receives the texts below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=   # E.g. +14155550123
# Public hostname of this server, no scheme (e.g. my-app.onrender.com or abc.ngrok.app)
PUBLIC_HOST=
PORT=3000

# Stripe (optional). Lets the agent text a one-time payment link with send_payment_request.
# Use a test-mode secret key (sk_test_...) unless you mean to take real payments.
STRIPE_SECRET_KEY=

# MongoDB Atlas (optional; falls back to an in-memory seeded store)
MONGODB_URI=
MONGODB_DB=snoopy

# Dashboard API (optional)
# If set, /api requires header x-dashboard-token (except /api/health and OPTIONS)
DASHBOARD_TOKEN=
# Comma-separated allowed CORS origins; empty means *
ALLOWED_ORIGINS=
