# Required
GEMINI_API_KEY=

# Twilio (optional locally; set to validate webhook signatures)
TWILIO_AUTH_TOKEN=
# Public hostname of this server, no scheme (e.g. my-app.onrender.com or abc.ngrok.app)
PUBLIC_HOST=
PORT=3000

# MongoDB Atlas (optional; falls back to an in-memory seeded store)
MONGODB_URI=
MONGODB_DB=snoopy
